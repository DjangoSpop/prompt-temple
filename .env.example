# PromptCraft Environment Configuration
# Copy this file to .env.local for development

# =================================
# API Configuration
# =================================
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
BACKEND_URL=https://YOUR-BACKEND-DOMAIN  # Use HTTPS in production
NEXT_PUBLIC_APP_NAME=PromptCraft
NEXT_PUBLIC_APP_VERSION=1.0.0

# =================================
# Environment
# =================================
NODE_ENV=development
NEXT_PUBLIC_APP_ENVIRONMENT=development

# =================================
# Authentication
# =================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-development-secret-key-change-in-production

# =================================
# Third-party Authentication (Optional)
# =================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Database (if using direct DB connection)
DATABASE_URL=postgresql://username:password@localhost:5432/forge_dashboard

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# Analytics & Monitoring
ANALYTICS_API_KEY=your_analytics_api_key
SENTRY_DSN=your_sentry_dsn_for_error_tracking

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_TEAMS=true
ENABLE_BILLING=true

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000, http://127.0.0.1:8000, https://yourdomain.com