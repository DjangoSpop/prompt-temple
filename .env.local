# PromptCraft Environment Configuration

# =================================
# Environment
# =================================
NODE_ENV=development
NEXT_PUBLIC_APP_ENVIRONMENT=development
# https://web-production-b54aa.up.railway.app/
# =================================
# API Configuration
# =================================
# Use the production API host with the /api base path. This should point to the
# API root used by the frontend. The OpenAPI UI is at
# https://api.prompt-temple.com/api/schema/swagger-ui/ which implies the API
# root is under /api/.
NEXT_PUBLIC_API_BASE_URL=https://api.prompt-temple.com
# Use secure websockets and assume the backend exposes a websocket endpoint at
# wss://api.prompt-temple.com/ws. If your backend uses a different path change
# this value accordingly.
NEXT_PUBLIC_WS_URL=wss://api.prompt-temple.com/ws
# Backend API base used by server-side code. Keep in sync with NEXT_PUBLIC_API_BASE_URL
BACKEND_URL=https://api.prompt-temple.com
NEXT_PUBLIC_APP_NAME=PromptCraft
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_USE_MOCK_DATA=false

# =================================
# AI Configuration - DeepSeek
# =================================
DEEPSEEK_API_KEY=sk-fad996d33334443dab24fcd669653814
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# =================================
# Authentication
# =================================
# If you want to run full end-to-end tests against the deployed host, set the
# app URL to the public domain. If you are still developing locally, keep
# `http://localhost:3000` instead. Change as needed.
NEXTAUTH_URL=https://prompt-temple.com
NEXTAUTH_SECRET=development-secret-key-change-in-production

# =================================
# CORS Configuration
# =================================
# Allow both the public site and API host plus local dev URLs.
ALLOWED_ORIGINS=https://prompt-temple.com,https://api.prompt-temple.com,http://localhost:3000,http://127.0.0.1:8000

# =================================
# Feature Flags
# =================================
ENABLE_ANALYTICS=true
ENABLE_TEAMS=true
ENABLE_BILLING=false
NEXT_PUBLIC_DEV_MODE=true

# =================================
# Database & Redis (Optional)
# =================================
DATABASE_URL=postgresql://username:password@localhost:5432/promptcraft_db
REDIS_URL=redis://localhost:6379

# =================================
# Third-party Authentication (Optional)
# =================================
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# =================================
# Analytics & Monitoring (Optional)
# =================================
# ANALYTICS_API_KEY=your_analytics_api_key
# SENTRY_DSN=your_sentry_dsn_for_error_tracking